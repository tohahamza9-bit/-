# ── نموذج متغيّرات البيئة (§14.3) — انسخه إلى .env واملأه ──
# لا تضع أي مفتاح حقيقي في الكود أو GitHub.

# MongoDB (مصدر الحقيقة §2)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=moneyado

# SQL Server — تحقّق قراءة فقط (§11.4). مستخدم قراءة فقط، ليس sa.
SQL_ENABLED=false
SQL_DSN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=.\SQLEXPRESS;DATABASE=MONEYADO_TEST;UID=bot_readonly;PWD=CHANGE_ME;TrustServerCertificate=yes

# الغرف (ملحق ب-4) — معرّفات JID من واتساب
# 🔴 المركزية والمسؤول = حدود الكتابة (whitelist §2.2) — تبقى من env دائمًا، لا تُقرأ من DB.
CENTRAL_ROOM_JID=
ADMIN_ROOM_JID=
# الزبائن/الخزائن: تُدار الآن في MongoDB (اكتشاف تلقائي + تصنيف من Dashboard، تفعيل بلا إعادة تشغيل).
# القيم أدناه تُبذَر أول تشغيل فقط (seed) لعدم كسر الإعداد القائم؛ بعدها المصدر = مجموعة rooms.
CUSTOMER_ROOM_JIDS=
TREASURY_ROOM_JIDS=

# جسر WhatsApp (Baileys ↔ Python)
WHATSAPP_BRIDGE_URL=http://localhost:3001
INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM   # SEC-002 X-Internal-Token
# مجلد جلسة واتساب (creds). فارغ = <حزمة whatsapp>/session تلقائيًا (مطلق، مستقلّ عن cwd).
# 🔴 في الإنتاج استعمل مسارًا مطلقًا ثابتًا حتى تُستأنف الجلسة بلا QR عبر إعادات التشغيل.
# نسبي؟ يُحلّ نسبةً لجذر حزمة whatsapp (لا مجلد التشغيل). مثال إنتاج: WA_SESSION_DIR=D:\moneyado\wa-session
WA_SESSION_DIR=

# MONEYADO RPA
MONEYADO_FIELDS_FILE=config/moneyado_fields.json
MONEYADO_PASSWORD_ENCRYPTED=            # DPAPI base64 (§2.1) — ليس نصًّا واضحًا
# مهل RPA بالثواني (جهاز بطيء/Windows قديم §11.3) — ارفعها لو علّق البوت قبل جاهزية الشاشة.
MONEYADO_STEP_DELAY=0.3                 # سكون بعد تعبئة كل حقل
MONEYADO_ENTER_WAIT=3.0                 # انتظار ظهور اسم الزبون بعد Enter (إجمالي)
MONEYADO_POST_STORE_WAIT=2.0           # انتظار بعد «تخزين» قبل فحص النافذة الطارئة
MONEYADO_CONNECT_WAIT=1.0              # انتظار بعد تثبيت النافذة قبل أي تفاعل

# التشغيل
DASHBOARD_PORT=8000
DRY_RUN=true                            # true = لا كتابة فعلية في MONEYADO (الافتراضي الآمن)
